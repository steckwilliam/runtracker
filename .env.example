FLASK_SECRET_KEY=replace-with-a-local-secret-key

# Local development database (default). Use public_runtracker.db for the public site.
DATABASE_PATH=runtracker.db

# Set to true only for local Strava OAuth/sync development.
ENABLE_STRAVA_ROUTES=false

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional legacy fallback; OAuth tokens are stored in SQLite after /strava/connect
STRAVA_REFRESH_TOKEN=
STRAVA_REDIRECT_URI=http://localhost:5000/strava/callback

# Run Planner defaults to New Orleans.
WEATHER_API_BASE_URL=https://api.open-meteo.com
WEATHER_LATITUDE=29.9511
WEATHER_LONGITUDE=-90.0715
WEATHER_TIMEZONE=America/Chicago
WEATHER_HISTORICAL_API_BASE_URL=https://archive-api.open-meteo.com
